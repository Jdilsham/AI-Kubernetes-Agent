# Rendered at container start by the nginx image (envsubst): ${BACKEND_URL} is set by Helm / compose.
server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  # Live progress (Server-Sent Events) must not be buffered
  location ~ ^/api/investigations/[^/]+/events$ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 300s;
  }

  location = /index.html {
    add_header Cache-Control "no-store";
  }

  location / {
    try_files $uri /index.html;
  }
}
