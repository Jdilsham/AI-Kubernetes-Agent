# Claude (recommended): the AI investigates in a loop, running read-only kubectl commands it chooses itself.
# When ANTHROPIC_API_KEY is set it is used instead of the OpenRouter settings below.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AGENT_MAX_STEPS=15
# AGENT_EFFORT=medium

# Or: any OpenAI-compatible endpoint (default OpenRouter), one prompt with all the evidence
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Investigate step by step with this model too (needs a model with tool calling, e.g. nvidia/nemotron-3-ultra-550b-a55b:free)
# AGENT_MODE=loop
# Slow free models may need more than the default 120 s for a call after a long investigation
# LLM_TIMEOUT_SECONDS=300

# Auth: "password" or "none"
AUTH_MODE=password
ADMIN_PASSWORD=

# Local dev only; inside a cluster leave empty to use the ServiceAccount
KUBECONFIG_PATH=
DATA_DIR=./data
