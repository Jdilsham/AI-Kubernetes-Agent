# LLM: any OpenAI-compatible endpoint (default OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Auth: "password" or "none"
AUTH_MODE=password
ADMIN_PASSWORD=

# Local dev only; inside a cluster leave empty to use the ServiceAccount
KUBECONFIG_PATH=
DATA_DIR=./data
